{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate} %}

{% if error == 'selfReset' %}
    <div class="errorbox" role="alert"><p>{{ translate({ ident: "OXID2FA_ERROR_SELF_RESET" }) }}</p></div>
{% endif %}

{% if not mayManage %}
    <div class="messagebox"><p class="message">{{ translate({ ident: "OXID2FA_RESET_NOT_ALLOWED" }) }}</p></div>
{% else %}
    <table cellspacing="0" cellpadding="0" border="0" width="98%">
        <tr>
            <td class="listheader first" height="15">&nbsp;{{ translate({ ident: "OXID2FA_COL_ACCOUNT" }) }}</td>
            <td class="listheader" height="15">
                {{ translate({ ident: "OXID2FA_STATUS" }) }}
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("OXID2FA_HELP_STATUS"), 'sHelpText': help_text("OXID2FA_HELP_STATUS")} %}
            </td>
            <td class="listheader" height="15">
                {{ translate({ ident: "OXID2FA_COL_REQUIRED" }) }}
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("OXID2FA_HELP_REQUIRED"), 'sHelpText': help_text("OXID2FA_HELP_REQUIRED")} %}
            </td>
            <td class="listheader" height="15">
                {{ translate({ ident: "OXID2FA_COL_ATTEMPTS" }) }}
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("OXID2FA_HELP_ATTEMPTS"), 'sHelpText': help_text("OXID2FA_HELP_ATTEMPTS")} %}
            </td>
            <td class="listheader" height="15">&nbsp;</td>
        </tr>
        {% for row in adminRows %}
            {% set cls = loop.index is odd ? 'listitem' : 'listitem2' %}
            <tr>
                <td class="{{ cls }}" height="20">&nbsp;{{ row.loginName }}{% if row.isSelf %} <i>({{ translate({ ident: "OXID2FA_COL_YOU" }) }})</i>{% endif %}</td>
                <td class="{{ cls }}">
                    {% if row.status == 'active' %}<b>{{ translate({ ident: "OXID2FA_STATUS_ACTIVE" }) }}</b>{% if row.enabledAt %} ({{ row.enabledAt }}){% endif %}
                    {% elseif row.status == 'setup' %}{{ translate({ ident: "OXID2FA_STATUS_SETUP" }) }}
                    {% else %}{{ translate({ ident: "OXID2FA_STATUS_INACTIVE" }) }}{% endif %}
                </td>
                <td class="{{ cls }}">
                    <form action="{{ oViewConf.getSelfLink()|raw }}" method="post" style="display: inline;">
                        {{ oViewConf.getHiddenSid()|raw }}
                        <input type="hidden" name="cl" value="oxid2fa_admin_overview">
                        <input type="hidden" name="fnc" value="setRequired">
                        <input type="hidden" name="userid" value="{{ row.userId }}">
                        <input type="hidden" name="required" value="{{ row.required ? '0' : '1' }}">
                        <b>{{ translate({ ident: row.required ? "OXID2FA_REQUIRED_YES" : "OXID2FA_REQUIRED_NO" }) }}</b>
                        <input type="submit" class="edittext" value="{{ translate({ ident: row.required ? "OXID2FA_RELEASE" : "OXID2FA_REQUIRE" }) }}">
                    </form>
                </td>
                <td class="{{ cls }}">
                    {% if row.locked %}
                        <form action="{{ oViewConf.getSelfLink()|raw }}" method="post" style="display: inline;">
                            {{ oViewConf.getHiddenSid()|raw }}
                            <input type="hidden" name="cl" value="oxid2fa_admin_overview">
                            <input type="hidden" name="fnc" value="unlock">
                            <input type="hidden" name="userid" value="{{ row.userId }}">
                            <b>{{ translate({ ident: "OXID2FA_LOCKED" }) }}</b>
                            <input type="submit" class="edittext" value="{{ translate({ ident: "OXID2FA_UNLOCK" }) }}">
                        </form>
                    {% elseif row.failedAttempts > 0 %}{{ row.failedAttempts }}
                    {% else %}&ndash;{% endif %}
                </td>
                <td class="{{ cls }}">
                    {% if row.status != 'none' and not row.isSelf %}
                        <form action="{{ oViewConf.getSelfLink()|raw }}" method="post" style="display: inline;"
                              onsubmit="return confirm('{{ translate({ ident: "OXID2FA_RESET_CONFIRM" })|e('js') }}');">
                            {{ oViewConf.getHiddenSid()|raw }}
                            <input type="hidden" name="cl" value="oxid2fa_admin_overview">
                            <input type="hidden" name="fnc" value="resetUser">
                            <input type="hidden" name="userid" value="{{ row.userId }}">
                            <input type="submit" class="edittext" value="{{ translate({ ident: "OXID2FA_RESET" }) }}">
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </table>

    <br>
    <table cellspacing="0" cellpadding="0" border="0" width="98%">
        <tr>
            <td class="edittext">
                <b>{{ translate({ ident: "OXID2FA_LOG_TITLE" }) }}</b>
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("OXID2FA_HELP_LOG"), 'sHelpText': help_text("OXID2FA_HELP_LOG")} %}
            </td>
        </tr>
    </table>
    {% include "@oxid2fa/admin/include/twofactor_log.html.twig" with {auditRows: auditRows, showAccount: true} %}
{% endif %}

{% include "bottomnaviitem.html.twig" %}
{% include "bottomitem.html.twig" %}
