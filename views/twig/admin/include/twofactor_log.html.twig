{# Audit log table; expects auditRows, optional showAccount #}
{% if auditRows %}
    <table cellspacing="0" cellpadding="0" border="0" width="98%">
        <tr>
            <td class="listheader first" height="15" width="16%">&nbsp;{{ translate({ ident: "OXID2FA_LOG_TIME" }) }}</td>
            <td class="listheader" height="15" width="{{ showAccount ? '26%' : '34%' }}">{{ translate({ ident: "OXID2FA_LOG_EVENT" }) }}</td>
            {% if showAccount %}<td class="listheader" height="15" width="20%">{{ translate({ ident: "OXID2FA_LOG_ACCOUNT" }) }}</td>{% endif %}
            <td class="listheader" height="15" width="{{ showAccount ? '20%' : '28%' }}">{{ translate({ ident: "OXID2FA_LOG_ACTOR" }) }}</td>
            <td class="listheader" height="15" width="18%">{{ translate({ ident: "OXID2FA_LOG_ORIGIN" }) }}</td>
        </tr>
        {% for row in auditRows %}
            {% set cls = loop.index is odd ? 'listitem' : 'listitem2' %}
            {# turned down sign-in attempts are red, like the admin's own error messages #}
            {% set red = row.isRefusal ? 'color: #F00000;' : '' %}
            <tr>
                <td class="{{ cls }}" height="20" nowrap style="{{ red }}">&nbsp;{{ row.time }}</td>
                <td class="{{ cls }}" style="{{ red }}">{% if row.isRefusal %}<b>{{ translate({ ident: "OXID2FA_EVENT_" ~ row.event }) }}</b>{% else %}{{ translate({ ident: "OXID2FA_EVENT_" ~ row.event }) }}{% endif %}</td>
                {% if showAccount %}<td class="{{ cls }}" style="{{ red }}">{{ row.account }}</td>{% endif %}
                <td class="{{ cls }}" style="{{ red }}">{{ row.actor }}</td>
                <td class="{{ cls }}" style="{{ red }}" translate="no">{{ row.origin }}</td>
            </tr>
        {% endfor %}
    </table>
{% else %}
    <div class="messagebox"><p class="message">{{ translate({ ident: "OXID2FA_LOG_EMPTY" }) }}</p></div>
{% endif %}
